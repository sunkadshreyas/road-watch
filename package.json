{
  "name": "road-watch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "predev": "node scripts/check-runtime.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/check-runtime.mjs",
    "build": "next build",
    "prestart": "node scripts/check-runtime.mjs",
    "start": "next start",
    "pretest": "node scripts/check-runtime.mjs",
    "test": "node --import tsx --test --test-concurrency=1",
    "lint": "eslint",
    "preverify": "node scripts/check-runtime.mjs",
    "verify": "npm run lint && npm test && npm run build && npm run verify:mobile",
    "preverify:mobile": "node scripts/check-runtime.mjs",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "playwright": "^1.60.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
