DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional local development adapter for bearer-protected /api/v1 routes.
# Supply a JSON object whose keys are locally managed opaque tokens of at least
# 16 characters and whose values are existing User IDs. Leave it unset to keep
# native API authentication disabled. This is not production authentication.
# ROADWATCH_API_TOKENS_JSON=

# Set this only in a PostgreSQL-backed production runtime. It makes a local
# SQLite DATABASE_URL fail closed instead of silently becoming production data.
# ROADWATCH_RUNTIME_MODE=production
