EXPO_PUBLIC_API_URL=http://localhost:3000
# Local simulator only. Uses seeded resident profiles and an in-memory fallback
# when an unsigned simulator build cannot access the iOS keychain.
# EXPO_PUBLIC_DEMO_MODE=1
# iOS Simulator has no camera hardware. Enable a clearly labeled simulated
# preview and generated test capture while keeping physical-device behavior real.
# EXPO_PUBLIC_SIMULATOR_CAMERA=1
